<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">starlock</string>
    <string name="app_display_title">星辰超级岛</string>
    <string name="app_desc">将小米手机应用锁的解锁动画迁移到超级岛展示</string>
    <string name="community_footer">欢迎加入小米Magisk交流讨论群362389597</string>

    <string name="pref_enabled_title">启用应用锁超级岛</string>
    <string name="pref_enabled_desc">在超级岛上展示应用锁解锁动画与状态</string>

    <string name="pref_success_anim_title">显示成功动画</string>
    <string name="pref_success_anim_desc">解锁成功时在超级岛展示成功动画</string>

    <string name="pref_hide_dialog_title">隐藏原始解锁弹窗</string>
    <string name="pref_hide_dialog_desc">尝试隐藏系统默认的应用锁验证界面（实验性功能）</string>

    <string name="pref_keep_success_title">成功状态持续显示</string>
    <string name="pref_keep_success_desc">解锁成功后在超级岛保持显示，直到超时收起</string>

    <string name="test_island_title">测试超级岛</string>
    <string name="test_island_desc">验证模块与超级岛链路是否正常，无需真正解锁应用</string>
    <string name="test_island_sent">已发送测试请求，请查看顶部超级岛</string>

    <string name="usage_hint">使用说明：
1. 请在 LSPosed 中启用本模块
2. 勾选作用域：系统界面 (SystemUI)、安全中心
3. 重启手机后生效
4. 打开任意已加锁应用，解锁动画将显示在顶部超级岛</string>
</resources>
